@model PropertyRental.Web.Models.ApplicantDashboardViewModel
@using PropertyRental.Domain.Enums
@{
    ViewData["Title"] = "Applicant dashboard";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-header__title h2">My rental applications</h1>
        <p class="page-header__meta">@Model.Applications.Count applications</p>
    </div>
    <a class="btn btn-primary" asp-controller="Units" asp-action="Available">Browse available units</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>

<form asp-controller="Dashboard" asp-action="Applicant" method="get" class="filter-panel row g-3 align-items-end">
    <div class="col-sm-6 col-lg-2">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="Status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<ApplicationStatus>())
            {
                <option value="@((byte)status)" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="moveInFrom" class="form-label">Move-in from</label>
        <input id="moveInFrom" name="MoveInFrom" type="date" value="@Model.MoveInFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="moveInTo" class="form-label">Move-in to</label>
        <input id="moveInTo" name="MoveInTo" type="date" value="@Model.MoveInTo?.ToString("yyyy-MM-dd")" class="form-control" />
        <span asp-validation-for="MoveInTo" class="text-danger"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label for="propertyId" class="form-label">Property</label>
        <select id="propertyId" name="PropertyId" class="form-select">
            <option value="">All properties</option>
            @foreach (var property in Model.Properties)
            {
                <option value="@property.Id" selected="@(Model.PropertyId == property.Id)">@property.Name, @property.City</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="unitId" class="form-label">Unit</label>
        <select id="unitId" name="UnitId" class="form-select">
            <option value="">All units</option>
            @foreach (var unit in Model.Units)
            {
                <option value="@unit.Id" selected="@(Model.UnitId == unit.Id)">@unit.UnitNumber</option>
            }
        </select>
    </div>
    <div class="col-auto d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" type="submit">Apply filters</button>
        <a class="btn btn-link" asp-controller="Dashboard" asp-action="Applicant">Clear</a>
    </div>
</form>

@if (Model.Applications.Count == 0)
{
    <div class="empty-state">
        <h2>No applications found</h2>
        <p>Try changing the filters or browse available rental units.</p>
    </div>
}
else
{
    <div class="table-shell table-responsive">
        <table class="table align-middle" aria-label="Applicant applications table">
            <thead>
                <tr>
                    <th scope="col">Property / unit</th>
                    <th scope="col">Desired move-in</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last updated</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model.Applications)
                {
                    var applicationStatus = (ApplicationStatus)application.StatusId;
                    var badgeClass = applicationStatus switch
                    {
                        ApplicationStatus.Approved => "status-badge status-badge--success",
                        ApplicationStatus.Rejected or ApplicationStatus.Withdrawn => "status-badge status-badge--secondary",
                        ApplicationStatus.ReturnedForCorrection => "status-badge status-badge--warning",
                        ApplicationStatus.Submitted or ApplicationStatus.UnderReview => "status-badge status-badge--primary",
                        _ => "status-badge status-badge--light"
                    };
                    var canEdit = applicationStatus is ApplicationStatus.Draft or ApplicationStatus.ReturnedForCorrection;
                    var canWithdraw = applicationStatus is ApplicationStatus.Draft
                        or ApplicationStatus.Submitted
                        or ApplicationStatus.UnderReview
                        or ApplicationStatus.ReturnedForCorrection;
                    <tr>
                        <td>
                            <a asp-controller="Applications" asp-action="Details" asp-route-id="@application.Id">@application.Unit.Property.Name</a>
                            <span class="muted-stack">Unit @application.Unit.UnitNumber · @application.Unit.Property.City</span>
                        </td>
                        <td>@(application.DesiredMoveInDate?.ToString("d") ?? "Not set")</td>
                        <td><span class="@badgeClass">@application.Status.Name</span></td>
                        <td><time datetime="@application.UpdatedUtc.ToString("O")">@application.UpdatedUtc.ToLocalTime().ToString("g")</time></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Applications" asp-action="Details" asp-route-id="@application.Id">View</a>
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Applications" asp-action="Edit" asp-route-id="@application.Id">Edit</a>
                            }
                            @if (canWithdraw)
                            {
                                <form asp-controller="Applications" asp-action="Withdraw" asp-route-id="@application.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Withdraw</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}