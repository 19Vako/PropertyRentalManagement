@model IReadOnlyList<PropertyRental.Domain.Entities.RentalApplication>
@{
    var isApplicant = User.IsInRole(PropertyRental.Domain.Identity.RoleNames.Applicant);
    ViewData["Title"] = isApplicant ? "Applicant dashboard" : "Manager dashboard";
}

<h1>@ViewData["Title"]</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No applications to display.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    @if (!isApplicant)
                    {
                        <th scope="col">Applicant</th>
                    }
                    <th scope="col">Property</th>
                    <th scope="col">Unit</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td>@application.Id</td>
                        @if (!isApplicant)
                        {
                            <td>@application.ApplicantUserId</td>
                        }
                        <td>@application.Unit.Property.Name</td>
                        <td>@application.Unit.UnitNumber</td>
                        <td>@application.Status.Name</td>
                        <td><time datetime="@application.CreatedUtc.ToString("O")">@application.CreatedUtc.ToLocalTime().ToString("g")</time></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
