@model PropertyRental.Domain.Entities.Property
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <a asp-action="Index" class="text-decoration-none">Properties</a>
        <h1 class="page-header__title h2 mt-2">@Model.Name</h1>
        <p class="page-header__meta">@Model.StreetAddress, @Model.City, @Model.Region @Model.PostalCode, @Model.CountryCode</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit property</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="mb-4">@Model.Description</p>
}

<div class="section-header border-top pt-4">
    <h2 class="h4">Units <span class="text-muted">@Model.Units.Count</span></h2>
    @if (Model.IsActive)
    {
        <a class="btn btn-primary btn-sm" asp-controller="Units" asp-action="Create" asp-route-propertyId="@Model.Id">Add unit</a>
    }
</div>

@if (Model.Units.Count == 0)
{
    <div class="empty-state">
        <h3>No units yet</h3>
        <p>Add the first unit to this property.</p>
    </div>
}
else
{
    <div class="table-shell table-responsive">
        <table class="table align-middle" aria-label="Property units table">
            <thead><tr><th scope="col">Unit</th><th scope="col">Rent</th><th scope="col">Bedrooms</th><th scope="col">Bathrooms</th><th scope="col">Status</th><th scope="col" class="text-end">Action</th></tr></thead>
            <tbody>
                @foreach (var unit in Model.Units.OrderBy(unit => unit.UnitNumber))
                {
                    var unitStatusClass = unit.Status switch
                    {
                        PropertyRental.Domain.Enums.UnitStatus.Available => "status-badge status-badge--success",
                        PropertyRental.Domain.Enums.UnitStatus.Leased => "status-badge status-badge--secondary",
                        PropertyRental.Domain.Enums.UnitStatus.Maintenance => "status-badge status-badge--warning",
                        _ => "status-badge status-badge--light"
                    };
                    <tr>
                        <td><a asp-controller="Units" asp-action="Details" asp-route-id="@unit.Id">@unit.UnitNumber</a></td>
                        <td>@unit.MonthlyRent.ToString("C") / month</td>
                        <td>@unit.Bedrooms</td>
                        <td>@unit.Bathrooms</td>
                        <td><span class="@unitStatusClass">@unit.Status</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-controller="Units" asp-action="Edit" asp-route-id="@unit.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}