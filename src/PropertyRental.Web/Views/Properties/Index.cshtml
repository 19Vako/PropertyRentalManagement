@model IReadOnlyList<PropertyRental.Domain.Entities.Property>
@{
    ViewData["Title"] = "Properties";
    var search = ViewData["Search"] as string;
    var isActive = ViewData["IsActive"] as bool?;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1 class="page-header__title h2">Properties</h1>
        <p class="page-header__meta">@Model.Count managed properties</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add property</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<form method="get" class="filter-panel row g-3 align-items-end">
    <div class="col-sm-7 col-lg-5">
        <label class="form-label" for="search">Search</label>
        <input id="search" name="search" value="@search" class="form-control" placeholder="Name, city, or address" />
    </div>
    <div class="col-sm-3 col-lg-2">
        <label class="form-label" for="isActive">State</label>
        <select id="isActive" name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(isActive == true)">Active</option>
            <option value="false" selected="@(isActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-auto d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" type="submit">Filter</button>
        <a class="btn btn-link" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>No properties match</h2>
        <p>Try adjusting the filters or add a new property.</p>
    </div>
}
else
{
    <div class="table-shell table-responsive">
        <table class="table align-middle" aria-label="Properties table">
            <thead>
                <tr><th scope="col">Name</th><th scope="col">Address</th><th scope="col">Units</th><th scope="col">State</th><th scope="col" class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    var stateClass = property.IsActive ? "status-badge status-badge--success" : "status-badge status-badge--secondary";
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@property.Id">@property.Name</a></td>
                        <td>@property.StreetAddress, @property.City</td>
                        <td>@property.Units.Count</td>
                        <td><span class="@stateClass">@(property.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@property.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}