@model PropertyRental.Web.Models.PropertyFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit property" : "Add property";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">Properties</a>
    <h1 class="h2 mt-2">@ViewData["Title"]</h1>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="filter-panel row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>
    <input asp-for="Id" type="hidden" />
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CountryCode" class="form-label">Country code</label>
        <input asp-for="CountryCode" class="form-control" maxlength="2" autocomplete="country" />
        <span asp-validation-for="CountryCode" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="StreetAddress" class="form-label"></label>
        <input asp-for="StreetAddress" class="form-control" autocomplete="street-address" />
        <span asp-validation-for="StreetAddress" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" autocomplete="address-level2" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Region" class="form-label"></label>
        <input asp-for="Region" class="form-control" autocomplete="address-level1" />
        <span asp-validation-for="Region" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PostalCode" class="form-label"></label>
        <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
        <span asp-validation-for="PostalCode" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-12 form-check ms-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Property is active</label>
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Create property")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}