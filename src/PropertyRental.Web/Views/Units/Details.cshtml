@model PropertyRental.Domain.Entities.Unit
@{
    ViewData["Title"] = $"Unit {Model.UnitNumber}";
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none">@Model.Property.Name</a>
        <h1 class="page-header__title h2 mt-2">Unit @Model.UnitNumber</h1>
        <p class="page-header__meta">@Model.Property.StreetAddress, @Model.Property.City</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit unit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

<dl class="row g-3 border-top pt-4 card-surface p-3 mb-4">
    <dt class="col-sm-3">Monthly rent</dt><dd class="col-sm-9">@Model.MonthlyRent.ToString("C")</dd>
    <dt class="col-sm-3">Bedrooms</dt><dd class="col-sm-9">@Model.Bedrooms</dd>
    <dt class="col-sm-3">Bathrooms</dt><dd class="col-sm-9">@Model.Bathrooms</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="status-badge status-badge--light">@Model.Status</span></dd>
    <dt class="col-sm-3">Available from</dt><dd class="col-sm-9">@(Model.AvailableFrom?.ToString("D") ?? "Immediately")</dd>
</dl>