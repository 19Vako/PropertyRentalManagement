@model PropertyRental.Domain.Entities.Unit
@{
    ViewData["Title"] = "Delete unit";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">Back to unit</a>
<h1 class="h2 mt-2">Delete unit @Model.UnitNumber?</h1>
<p class="text-muted">Units referenced by applications or leases are retained as history. Change the unit status instead.</p>

<dl class="row mt-4">
    <dt class="col-sm-3">Property</dt><dd class="col-sm-9">@Model.Property.Name</dd>
    <dt class="col-sm-3">Monthly rent</dt><dd class="col-sm-9">@Model.MonthlyRent.ToString("C")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Delete unit</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>