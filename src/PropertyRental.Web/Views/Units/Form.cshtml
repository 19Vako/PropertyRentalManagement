@model PropertyRental.Web.Models.UnitFormViewModel
@using PropertyRental.Domain.Enums
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit unit" : "Add unit";
    var propertyName = Model.PropertyName;
    if (string.IsNullOrWhiteSpace(propertyName))
    {
        propertyName = ViewData["PropertyName"] as string ?? string.Empty;
    }
}

<div class="mb-4">
    <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none">@propertyName</a>
    <h1 class="h2 mt-2">@ViewData["Title"]</h1>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="filter-panel row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="PropertyId" type="hidden" />
    <div class="col-12">
        <div class="form-control-plaintext border rounded p-3 bg-light">Property: <strong>@propertyName</strong></div>
    </div>
    <div class="col-md-6">
        <label asp-for="UnitNumber" class="form-label"></label>
        <input asp-for="UnitNumber" class="form-control" />
        <span asp-validation-for="UnitNumber" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MonthlyRent" class="form-label">Monthly rent</label>
        <div class="input-group"><span class="input-group-text">$</span><input asp-for="MonthlyRent" class="form-control" type="number" min="0.01" step="0.01" /></div>
        <span asp-validation-for="MonthlyRent" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Bedrooms" class="form-label"></label>
        <input asp-for="Bedrooms" class="form-control" type="number" min="0" max="255" />
        <span asp-validation-for="Bedrooms" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Bathrooms" class="form-label"></label>
        <input asp-for="Bathrooms" class="form-control" type="number" min="0" max="99.9" step="0.1" />
        <span asp-validation-for="Bathrooms" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<UnitStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AvailableFrom" class="form-label"></label>
        <input asp-for="AvailableFrom" class="form-control" type="date" />
        <span asp-validation-for="AvailableFrom" class="text-danger"></span>
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Create unit")</button>
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}